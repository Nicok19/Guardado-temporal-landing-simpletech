---
// /ecosistema/partners — foto, partners tecnológicos, comerciales y cómo ser partner.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/common/PageHero.jsx';
import PartnersSection from '@/sections/Partners/PartnersSection.jsx';
import PhotoBand from '@/components/common/PhotoBand.jsx';
import { ECOSISTEMA_PHOTOS } from '@/data/ecosistema';
import { PAGE_SEO } from '@/config/seo';
import { navItem, navSubpage } from '@/data/navigation';

const nav = navItem('ecosistema');
const page = navSubpage('ecosistema', '/ecosistema/partners');
const seo = PAGE_SEO.ecosistemaPartners;
---

<BaseLayout {...seo}>
  <PageHero parent={nav} title={page.label} lead={seo.description} />
  <PhotoBand photo={ECOSISTEMA_PHOTOS.partners} />
  <PartnersSection />
</BaseLayout>
