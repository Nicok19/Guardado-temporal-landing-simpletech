---
// /blog/:slug — un artículo del blog de WordPress (services/wordpress.js), con su contenido limpio y estilos propios
// (styles/blog.css), y 3 artículos relacionados al pie. En inglés, portugués y francés se muestra la traducción
// guardada (services/blogTranslations.js); si todavía no hay, el original en español con un aviso.
import BaseLayout from '@/layouts/BaseLayout.astro';
import SmartLink from '@/components/common/SmartLink.jsx';
import PostCard, { formatPostDate } from '@/sections/Blog/PostCard.jsx';
import { SITE_NAME } from '@/config/seo';
import { blogPostPaths } from '@/services/wordpress';
import { getLang, localizeHref, t } from '@/i18n';
import { localizeCard, localizePost } from '@/services/blogTranslations';
import { FONT_MONO } from '@/styles/tokens';
import '@/styles/blog.css';

export const getStaticPaths = blogPostPaths;

const lang = getLang();
const post = await localizePost(Astro.props.post, lang);
const related = Astro.props.related.map((p) => localizeCard(p, lang));
---

<BaseLayout title={`${post.title} · ${SITE_NAME}`} description={post.excerpt} image={post.image || undefined} type="article">
  <article style="background:#F9F6EE;color:#00249C">
    <header style="padding:clamp(150px,15vw,190px) var(--page-x) clamp(32px,4vw,48px)">
      <div style="max-width:860px;margin:0 auto;display:flex;flex-direction:column;gap:22px">
        <nav
          aria-label="Breadcrumb"
          style={`display:flex;gap:10px;flex-wrap:wrap;font-family:${FONT_MONO};font-size:11px;letter-spacing:.18em;color:#636262`}
        >
          <SmartLink className="hv-c-ink" href="/nosotros" style={{ color: '#636262' }}>{t('NOSOTROS')}</SmartLink>
          <span aria-hidden="true">/</span>
          <SmartLink className="hv-c-ink" href="/blog" style={{ color: '#636262' }}>BLOG</SmartLink>
        </nav>
        {
          post.categories.length > 0 && (
            <div style="display:flex;flex-wrap:wrap;gap:6px">
              {post.categories.map((c) => (
                <span style="padding:5px 12px;border-radius:999px;background:#fff;border:1px solid #DADAE4;font-size:12px;font-weight:600">
                  {c}
                </span>
              ))}
            </div>
          )
        }
        <h1 style="margin:0;font-size:clamp(34px,4.6vw,60px);line-height:1.02;font-weight:800;letter-spacing:-.045em;text-wrap:balance">
          {post.title}
        </h1>
        <p style="margin:0;font-size:clamp(17px,1.4vw,20px);line-height:1.55;color:#636262">{post.excerpt}</p>
        <span style={`font-family:${FONT_MONO};font-size:11px;letter-spacing:.14em;color:#636262`}>
          {`${formatPostDate(post.date)} · ${t('{0} min de lectura').replace('{0}', post.minutes)}`.toUpperCase()}
        </span>
      </div>
    </header>

    {
      post.image && (
        <div style="padding:0 var(--page-x)">
          <img
            src={post.image}
            alt={post.imageAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            style="display:block;width:100%;max-width:1080px;margin:0 auto;border-radius:28px;aspect-ratio:1920/708;object-fit:cover;background:#0b1233"
          />
        </div>
      )
    }

    <div style="padding:clamp(40px,5vw,64px) var(--page-x) clamp(72px,8vw,112px)">
      {
        !post.translated && (
          <p style="max-width:720px;margin:0 auto 28px;padding:14px 18px;border-radius:14px;background:#fff;border:1px solid #DADAE4;font-size:15px;color:#636262">
            {t('Este artículo está disponible solo en español.')}
          </p>
        )
      }
      <div class="blog-prose" lang={post.translated ? undefined : 'es'} set:html={post.html} />
      <div style="max-width:720px;margin:48px auto 0;padding-top:28px;border-top:1px solid #DADAE4;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;align-items:center">
        <SmartLink className="hv-c-ink" href="/blog" style={{ color: '#00249C', fontWeight: 600, fontSize: '15px' }}>
          ← {t('Volver al blog')}
        </SmartLink>
        <SmartLink
          className="hv-bg-gold hv-c-blue"
          href={localizeHref('/#contacto')}
          style={{
            display: 'flex',
            gap: '12px',
            alignItems: 'center',
            padding: '14px 22px',
            borderRadius: '999px',
            background: '#00249C',
            color: '#F9F6EE',
            fontWeight: 700,
            fontSize: '15px',
            transition: 'all .3s',
          }}
        >
          {t('Conversemos')} <span style={`font-family:${FONT_MONO}`}>→</span>
        </SmartLink>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section style="background:#fff;color:#00249C;padding:clamp(72px,8vw,112px) var(--page-x)">
        <div style="max-width:var(--page-max);margin:0 auto;display:flex;flex-direction:column;gap:32px">
          <h2 style="margin:0;font-size:clamp(28px,3.2vw,44px);font-weight:800;letter-spacing:-.04em;line-height:1">
            {t('Más artículos')}
            <span style="color:#DCD291">.</span>
          </h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,300px),1fr));gap:20px">
            {related.map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
