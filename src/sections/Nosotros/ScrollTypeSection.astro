---
/**
 * Frase grande que se escribe letra por letra según el scroll (como una máquina de escribir).
 * La sección es más alta que la pantalla y el texto queda fijo (sticky) mientras se escribe. Solo avanza:
 * al scrollear hacia arriba no se borra.
 * El texto completo está en el HTML (SEO / lectores de pantalla); el script lo parte en letras ocultas
 * con `visibility: hidden` (styles/typewriter.css), así no hay saltos de layout.
 * Sin JS, con prefers-reduced-motion o en pantallas menores que tablet, la frase se ve completa y fija.
 */
import { FONT_MONO } from '@/styles/tokens';
import { t } from '@/i18n';
import '@/styles/typewriter.css';

interface Props {
  kicker?: string;
  text: string;
}

const { kicker, text } = Astro.props;
---

<section class="st-scrolltype" data-scrolltype>
  <div class="st-scrolltype-sticky">
    <div class="st-scrolltype-inner">
      {
        kicker && (
          <span class="st-scrolltype-kicker" style={{ fontFamily: FONT_MONO }}>
            {t(kicker)}
          </span>
        )
      }
      <p class="st-scrolltype-text" data-scrolltype-text>
        {t(text)}<span class="st-scrolltype-dot">.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .st-scrolltype {
    position: relative;
    height: 220vh;
    background: #f9f6ee;
    color: #00249c;
  }
  .st-scrolltype-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    padding: 0 var(--page-x);
  }
  .st-scrolltype-inner {
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .st-scrolltype-kicker {
    font-size: 12px;
    letter-spacing: 0.24em;
    color: #636262;
  }
  .st-scrolltype-text {
    margin: 0;
    font-size: clamp(48px, 9vw, 140px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  /* Menos que tablet: texto fijo normal, sin el juego del scroll (el script muestra todas las letras). */
  @media (max-width: 767.98px) {
    .st-scrolltype {
      height: auto;
      padding: clamp(72px, 10vw, 112px) 0;
    }
    .st-scrolltype-sticky {
      position: static;
      height: auto;
    }
  }
  .st-scrolltype-dot {
    color: #dcd291;
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Menos que tablet: sin el efecto (coincide con el @media del <style>).
  const small = matchMedia('(max-width: 767.98px)');

  // Parte el contenido en <span class="tw-char"> conservando los elementos internos (ej. el punto dorado).
  const splitInto = (source: Node, target: Node, chars: HTMLElement[]) => {
    source.childNodes.forEach((node) => {
      if (node.nodeType === Node.TEXT_NODE) {
        for (const ch of node.textContent ?? '') {
          const span = document.createElement('span');
          span.className = 'tw-char';
          span.textContent = ch;
          target.appendChild(span);
          chars.push(span);
        }
      } else if (node.nodeType === Node.ELEMENT_NODE) {
        const clone = node.cloneNode(false);
        target.appendChild(clone);
        splitInto(node, clone, chars);
      }
    });
  };

  document.querySelectorAll<HTMLElement>('[data-scrolltype]').forEach((section) => {
    const textEl = section.querySelector<HTMLElement>('[data-scrolltype-text]');
    if (!textEl || reduced) return;

    const label = textEl.textContent ?? '';
    const holder = document.createElement('span');
    const chars: HTMLElement[] = [];
    splitInto(textEl, holder, chars);
    textEl.replaceChildren(...holder.childNodes);
    textEl.setAttribute('aria-label', label);

    let shown = -1;
    const render = () => {
      if (small.matches) {
        if (shown === chars.length) return;
        shown = chars.length;
        chars.forEach((c) => {
          c.classList.add('tw-on');
          c.classList.remove('tw-caret');
        });
        return;
      }
      // 0 cuando la sección llega arriba; 1 al recorrer el 75% de su alto extra (queda un tramo con la frase completa).
      const rect = section.getBoundingClientRect();
      const range = (rect.height - window.innerHeight) * 0.75;
      const p = Math.min(1, Math.max(0, -rect.top / range));
      const n = Math.round(p * chars.length);
      if (n <= shown) return; // solo avanza: al volver hacia arriba no se borra
      shown = n;
      chars.forEach((c, i) => {
        c.classList.toggle('tw-on', i < n);
        c.classList.toggle('tw-caret', i === n - 1);
      });
    };

    let raf = 0;
    const onScroll = () => {
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          render();
        });
    };
    render();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  });
</script>
