---
/**
 * Fuentes alojadas en el propio sitio (paquetes @fontsource): sin CSS externo que bloquee el render.
 * Se declaran como "Inter" e "IBM Plex Mono" para que los estilos existentes las usen sin cambios.
 * Solo el subset latino (incluye á, é, í, ó, ú, ñ).
 */
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import plexMono400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import plexMono500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
// Poppins SemiBold (de @fontsource/poppins, copiada en src/assets/fonts): nombres de plataformas en la Home.
import poppins600 from '@/assets/fonts/poppins-latin-600-normal.woff2?url';

const fontFaces = `
@font-face{font-family:'Inter';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interWoff2}) format('woff2-variations'),url(${interWoff2}) format('woff2')}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-display:swap;font-weight:400;src:url(${plexMono400}) format('woff2')}
@font-face{font-family:'IBM Plex Mono';font-style:normal;font-display:swap;font-weight:500;src:url(${plexMono500}) format('woff2')}
@font-face{font-family:'Poppins';font-style:normal;font-display:swap;font-weight:600;src:url(${poppins600}) format('woff2')}
`;
---

<link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={fontFaces}></style>
