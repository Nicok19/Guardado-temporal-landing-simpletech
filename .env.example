# Copiá este archivo a `.env.local` y completá los valores.
# Solo las variables que empiezan con PUBLIC_ llegan al navegador.

# URL pública del sitio (canonical, Open Graph, sitemap).
PUBLIC_SITE_URL=https://www.simpletech.uy

# URL base del backend. Ej: https://api.simpletech.uy  o  /api (si usás el proxy de desarrollo).
# Si queda vacío, los formularios funcionan con datos simulados (mocks).
PUBLIC_API_BASE_URL=

# Forzar mocks aunque haya PUBLIC_API_BASE_URL (true | false).
PUBLIC_USE_MOCKS=false

# Timeout de las requests en milisegundos.
PUBLIC_API_TIMEOUT_MS=15000

# Solo desarrollo: backend local al que el dev server redirige /api. Ej: http://localhost:3000
PUBLIC_API_PROXY_TARGET=

# Geolocalización (src/config/geo.js): endpoint del hosting que devuelve { "country": "BR" } según la IP del
# visitante. Vacío = el país se adivina por la zona horaria del navegador.
PUBLIC_GEO_ENDPOINT=
